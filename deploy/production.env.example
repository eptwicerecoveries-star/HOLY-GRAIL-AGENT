# Holy Grail — production environment template (P4-C1)
# Replace every placeholder before any real deploy. Contains NO secrets.
# Not deployable as-is. P4-C2/C3 choose hosting, DB, domain, and proxy identity.

SURPLUS_AI_ENV=prod

# Inject from the provider secret store (never commit the real value).
SURPLUS_AI_DATABASE_URL=<set-via-secret-store>

# Exact HTTPS origins only (no wildcards, no trailing slash).
SURPLUS_AI_AUTH_ORIGINS=https://example.invalid

# Exact hostnames only (no scheme, port, or "*").
SURPLUS_AI_ALLOWED_HOSTS=example.invalid

SURPLUS_AI_LOG_LEVEL=INFO

# Proxy trust stays DISABLED until P4-C3 knows the real edge/proxy identity.
# Do NOT set SURPLUS_AI_TRUST_PROXY_HEADERS=true with a guessed allowlist.
# Do NOT use "*" — Holy Grail rejects wildcard proxy trust.
SURPLUS_AI_TRUST_PROXY_HEADERS=false

# When (and only when) P4-C3 enables trust, set an explicit comma-separated
# allowlist of immediate proxy addresses/CIDRs supported by Uvicorn, e.g.:
# SURPLUS_AI_FORWARDED_ALLOW_IPS=10.0.0.0/8,203.0.113.10
# Leave unset while trust is false.
