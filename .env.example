SURPLUS_AI_ENV=dev
# Host-side local development (pytest / Windows uvicorn). DEVELOPMENT ONLY.
SURPLUS_AI_DATABASE_URL=postgresql+psycopg://surplus_ai:surplus_ai_dev@localhost:5432/surplus_ai
SURPLUS_AI_LOG_LEVEL=INFO
SURPLUS_AI_LOG_DIR=logs

# Docker Compose `app` / `migrate` services use hostname `postgres` (not localhost)
# via compose `environment`. Do not reuse these credentials in production.
